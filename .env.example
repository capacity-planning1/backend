DB__SCHEME=postgresql+asyncpg
DB__POSTGRES_HOST=localhost
DB__POSTGRES_PORT=5432
DB__POSTGRES_DB=capacity_planning
DB__POSTGRES_USER=postgres
DB__POSTGRES_PASSWORD=postgres
DB__ECHO=False

AUTH__PRIVATE_KEY_PATH=private.pem
AUTH__PUBLIC_KEY_PATH=public.pem
AUTH__ACCESS_TOKEN_LIFETIME_SECONDS=600
AUTH__REFRESH_TOKEN_LIFETIME_SECONDS=3600
AUTH__ALGORITHM=HS256

ROLE__ADMIN_EMAIL=admin@example.com
ROLE__ADMIN_PASSWORD=Admin123!
ROLE__ADMIN_FIRST_NAME=Admin
ROLE__ADMIN_LAST_NAME=User

ROLE__ADMIN_ROLE_CODE=admin
ROLE__DEFAULT_USER_ROLE_CODE=user

ROLE__ADMIN=admin
ROLE__USER=user

ROLE__BOOTSTRAP_ENABLED=true